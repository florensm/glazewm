<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stand-in for the WPF ticketing app used with GlazeWM's stacks: ticket
    windows titled "Ticket details for ...", and a modal "Add Activity"
    dialog that disables the app's other windows like WPF's `ShowDialog`.
    Named TicketDesk.exe so window rules matching the real app apply to it.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TicketDesk</AssemblyName>
    <RootNamespace>TicketDeskMock</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the app build without the .NET Framework developer pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
