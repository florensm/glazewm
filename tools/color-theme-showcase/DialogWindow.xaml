<Window x:Class="ColorThemeShowcase.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="260" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Nested dialog" Padding="10,3" Margin="0,0,8,0"
              Click="Nested_Click" />
      <Button Content="OK" IsDefault="True" Width="72" Margin="0,0,8,0"
              Click="Close_Click" />
      <Button Content="Cancel" IsCancel="True" Width="72" Click="Close_Click" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Dialog with its own popups" FontWeight="SemiBold"
                 Margin="0,0,0,8" />
      <ComboBox SelectedIndex="0" Margin="0,0,0,8">
        <ComboBoxItem>First choice</ComboBoxItem>
        <ComboBoxItem>Second choice</ComboBoxItem>
        <ComboBoxItem>Third choice</ComboBoxItem>
      </ComboBox>
      <TextBox Text="Text inside the dialog" Margin="0,0,0,8" />
      <CheckBox Content="Hover me for a tooltip" ToolTip="Tooltip inside a dialog" />
    </StackPanel>
  </DockPanel>
</Window>
