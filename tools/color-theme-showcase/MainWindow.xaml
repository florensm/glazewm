<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Theme Showcase" Width="900" Height="640"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <Style x:Key="Section" TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="Row" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Swatch" TargetType="Border">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="BorderBrush" Value="#808080" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <ContextMenu x:Key="SampleContextMenu">
      <MenuItem Header="Cut" InputGestureText="Ctrl+X" />
      <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
      <MenuItem Header="Paste" InputGestureText="Ctrl+V" />
      <Separator />
      <MenuItem Header="More">
        <MenuItem Header="Nested item one" />
        <MenuItem Header="Nested item two" />
      </MenuItem>
    </ContextMenu>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" />
        <MenuItem Header="_Open file..." x:Name="OpenFile" />
        <MenuItem Header="Open _recent">
          <MenuItem Header="report.docx" />
          <MenuItem Header="notes.txt" />
          <MenuItem Header="budget.xlsx" />
        </MenuItem>
        <Separator />
        <MenuItem Header="E_xit" x:Name="Exit" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Status bar" IsCheckable="True" IsChecked="True"
                  x:Name="ToggleStatusBar" />
        <MenuItem Header="Word wrap" IsCheckable="True" />
      </MenuItem>
      <MenuItem Header="_Window">
        <MenuItem Header="Grow by 100 px" x:Name="Grow" />
        <MenuItem Header="Shrink by 100 px" x:Name="Shrink" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" x:Name="About" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="Modal dialog" x:Name="ModalDialog"
                ToolTip="Owned window shown with ShowDialog" />
        <Button Content="Modeless dialog" x:Name="ModelessDialog"
                ToolTip="Owned window shown with Show" />
        <Button Content="Unowned window" x:Name="UnownedWindow"
                ToolTip="Separate top-level window without an owner" />
        <Separator />
        <Button Content="Message box" x:Name="ShowMessageBox" />
        <Button Content="Open file dialog" x:Name="OpenFileButton" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
      <StatusBarItem Content="Ready" />
      <Separator />
      <StatusBarItem x:Name="ClockItem" />
      <Separator />
      <StatusBarItem x:Name="SizeItem" />
    </StatusBar>

    <TabControl Margin="8">
      <TabItem Header="Controls">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <WrapPanel Margin="8">
            <GroupBox Header="Popups" Style="{StaticResource Section}" Width="400">
              <StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <ComboBox Width="160" SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem>Option one</ComboBoxItem>
                    <ComboBoxItem>Option two</ComboBoxItem>
                    <ComboBoxItem>Option three</ComboBoxItem>
                    <ComboBoxItem>Option four</ComboBoxItem>
                    <ComboBoxItem>Option five</ComboBoxItem>
                  </ComboBox>
                  <ComboBox Width="160" IsEditable="True" Text="Editable">
                    <ComboBoxItem>Alpha</ComboBoxItem>
                    <ComboBoxItem>Beta</ComboBoxItem>
                    <ComboBoxItem>Gamma</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <ToggleButton x:Name="PopupToggle" Content="Toggle popup"
                                Padding="10,3" Margin="0,0,8,0" />
                  <Popup IsOpen="{Binding IsChecked, ElementName=PopupToggle}"
                         PlacementTarget="{Binding ElementName=PopupToggle}"
                         StaysOpen="True">
                    <Border Background="White" BorderBrush="#808080"
                            BorderThickness="1" Padding="12">
                      <StackPanel>
                        <TextBlock Text="WPF Popup content" FontWeight="SemiBold" />
                        <TextBlock Text="Stays open until toggled again." />
                      </StackPanel>
                    </Border>
                  </Popup>
                  <Button Content="Hover for tooltip"
                          ToolTip="A tooltip with plain text" />
                  <DatePicker Width="120" />
                </StackPanel>
                <Border Background="#f3f3f3" BorderBrush="#c0c0c0" BorderThickness="1"
                        Padding="12" ContextMenu="{StaticResource SampleContextMenu}">
                  <TextBlock Text="Right-click here for a context menu" />
                </Border>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Inputs" Style="{StaticResource Section}" Width="400">
              <StackPanel>
                <TextBox Text="Editable text box" Margin="0,0,0,8" />
                <PasswordBox Password="secret" Margin="0,0,0,8" />
                <StackPanel Style="{StaticResource Row}">
                  <CheckBox Content="Checked" IsChecked="True" Margin="0,0,12,0" />
                  <CheckBox Content="Unchecked" Margin="0,0,12,0" />
                  <RadioButton Content="Radio A" IsChecked="True" Margin="0,0,12,0" />
                  <RadioButton Content="Radio B" />
                </StackPanel>
                <Slider Minimum="0" Maximum="100" Value="40" Margin="0,0,0,8" />
                <ProgressBar Height="14" Value="65" Margin="0,0,0,8" />
                <ProgressBar Height="14" IsIndeterminate="True"
                             ToolTip="Animates continuously, so the capture never idles" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Buttons" Style="{StaticResource Section}" Width="400">
              <StackPanel>
                <StackPanel Style="{StaticResource Row}">
                  <Button Content="Default" IsDefault="True" />
                  <Button Content="Normal" />
                  <Button Content="Disabled" IsEnabled="False" />
                </StackPanel>
                <Expander Header="Expander (click to resize content)">
                  <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="Expanding changes the layout without moving the window." />
                </Expander>
              </StackPanel>
            </GroupBox>
          </WrapPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Text">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock FontSize="9" Text="9 px: The quick brown fox jumps over the lazy dog." />
            <TextBlock FontSize="11" Text="11 px: The quick brown fox jumps over the lazy dog." />
            <TextBlock FontSize="12" Text="12 px: The quick brown fox jumps over the lazy dog." />
            <TextBlock FontSize="14" Text="14 px: The quick brown fox jumps over the lazy dog." />
            <TextBlock FontSize="18" Text="18 px: The quick brown fox jumps over the lazy dog." />
            <TextBlock FontSize="24" Text="24 px: The quick brown fox jumps over the lazy dog." />
            <TextBlock FontSize="12" FontWeight="Bold" Margin="0,8,0,0"
                       Text="Bold 12 px: 0123456789 ilI1| .,;:" />
            <TextBlock FontSize="12" FontStyle="Italic" Text="Italic 12 px: Hamburgefonstiv" />
            <TextBlock FontSize="12" FontFamily="Consolas" Text="Consolas: fn main() { let x = 42; }" />

            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Rendering modes" />
            <TextBlock TextOptions.TextRenderingMode="ClearType"
                       Text="ClearType: subpixel colored fringes" />
            <TextBlock TextOptions.TextRenderingMode="Grayscale"
                       Text="Grayscale: gray anti-aliasing" />
            <TextBlock TextOptions.TextRenderingMode="Aliased"
                       Text="Aliased: no anti-aliasing" />

            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Gray text on white" />
            <TextBlock Foreground="#333333" Text="#333333 body text" />
            <TextBlock Foreground="#666666" Text="#666666 secondary text" />
            <TextBlock Foreground="#999999" Text="#999999 placeholder text" />
            <TextBlock Foreground="#0078d4" Text="#0078d4 accent link text" TextDecorations="Underline" />

            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Already dark" />
            <Border Background="#202020" Padding="8">
              <TextBlock Foreground="#f0f0f0" Text="Light text on a dark panel" />
            </Border>

            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Hairlines" />
            <Canvas Height="40" SnapsToDevicePixels="True">
              <Line X1="0" Y1="5" X2="400" Y2="5" Stroke="Black" StrokeThickness="1" />
              <Line X1="0" Y1="15" X2="400" Y2="15" Stroke="#808080" StrokeThickness="1" />
              <Line X1="0" Y1="25" X2="400" Y2="35" Stroke="Black" StrokeThickness="1" />
            </Canvas>

            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Paragraph" />
            <TextBlock TextWrapping="Wrap" MaxWidth="600"
                       Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Colors">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4"
                       Text="Gray ramp (white to black): should map onto background to foreground" />
            <WrapPanel x:Name="GrayRamp" />

            <TextBlock FontWeight="SemiBold" Margin="0,12,0,4"
                       Text="Saturated: should keep their colors" />
            <WrapPanel>
              <Border Style="{StaticResource Swatch}" Background="#e81123" ToolTip="#e81123" />
              <Border Style="{StaticResource Swatch}" Background="#107c10" ToolTip="#107c10" />
              <Border Style="{StaticResource Swatch}" Background="#0063b1" ToolTip="#0063b1" />
              <Border Style="{StaticResource Swatch}" Background="#ff8c00" ToolTip="#ff8c00" />
              <Border Style="{StaticResource Swatch}" Background="#8764b8" ToolTip="#8764b8" />
            </WrapPanel>

            <TextBlock FontWeight="SemiBold" Margin="0,12,0,4"
                       Text="Low saturation: near the threshold" />
            <WrapPanel>
              <Border Style="{StaticResource Swatch}" Background="#f0f4ff" ToolTip="#f0f4ff" />
              <Border Style="{StaticResource Swatch}" Background="#fff5f5" ToolTip="#fff5f5" />
              <Border Style="{StaticResource Swatch}" Background="#dfe6e9" ToolTip="#dfe6e9" />
              <Border Style="{StaticResource Swatch}" Background="#b0bec5" ToolTip="#b0bec5" />
            </WrapPanel>

            <TextBlock FontWeight="SemiBold" Margin="0,12,0,4"
                       Text="Sample theme overrides (#fff3b0, #0078d4)" />
            <WrapPanel>
              <Border Style="{StaticResource Swatch}" Background="#fff3b0" ToolTip="#fff3b0" />
              <Border Style="{StaticResource Swatch}" Background="#0078d4" ToolTip="#0078d4" />
              <Border Background="#fff3b0" Padding="6,2" VerticalAlignment="Top">
                <TextBlock Text="Highlighted text" />
              </Border>
            </WrapPanel>

            <TextBlock FontWeight="SemiBold" Margin="0,12,0,4" Text="Gradients" />
            <Border Height="32" Margin="0,0,0,4">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="White" Offset="0" />
                  <GradientStop Color="Black" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border Height="32">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#e81123" Offset="0" />
                  <GradientStop Color="#ffb900" Offset="0.25" />
                  <GradientStop Color="#107c10" Offset="0.5" />
                  <GradientStop Color="#0078d4" Offset="0.75" />
                  <GradientStop Color="#8764b8" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Data">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DataGrid x:Name="People" AutoGenerateColumns="True" IsReadOnly="True"
                    AlternatingRowBackground="#f5f5f5" Margin="0,0,8,0"
                    ContextMenu="{StaticResource SampleContextMenu}" />
          <TreeView Grid.Column="1">
            <TreeViewItem Header="Documents" IsExpanded="True">
              <TreeViewItem Header="report.docx" />
              <TreeViewItem Header="notes.txt" />
              <TreeViewItem Header="Archive">
                <TreeViewItem Header="2024" />
                <TreeViewItem Header="2025" />
              </TreeViewItem>
            </TreeViewItem>
            <TreeViewItem Header="Pictures" />
            <TreeViewItem Header="Music" />
          </TreeView>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
